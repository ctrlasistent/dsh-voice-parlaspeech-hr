{
  "name": "dsh-voice-parlaspeech-hr",
  "description": "Local Croatian ASR using ParlaSpeech wav2vec2 model",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "runtime",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": ["linux", "win32", "darwin"]
    }
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "voice-input", "stt", "speech-to-text", "asr", "wav2vec2", "parlaspeech", "croatian", "local"],
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5"
  }
}
